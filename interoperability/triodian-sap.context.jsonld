{
  "@context": {
    "triodian": "https://triodian.com/ontology#",
    "sap": "https://sap.com/enterprise-architecture/",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "skos": "http://www.w3.org/2004/02/skos/core#"
  },
  "@graph": [
    {
      "@id": "triodian:Strategy",
      "rdfs:label": "Strategy",
      "skos:closeMatch": [
        {
          "@id": "sap:StrategicGoal"
        },
        {
          "@id": "sap:StrategicObjective"
        }
      ]
    },
    {
      "@id": "triodian:Capability",
      "rdfs:label": "Capability",
      "skos:closeMatch": [
        {
          "@id": "sap:BusinessCapability"
        },
        {
          "@id": "sap:Capability"
        }
      ]
    },
    {
      "@id": "triodian:ValueStream",
      "rdfs:label": "ValueStream",
      "skos:closeMatch": [
        {
          "@id": "sap:BusinessProcessSegment"
        },
        {
          "@id": "sap:ValueStream"
        }
      ]
    },
    {
      "@id": "triodian:Policy",
      "rdfs:label": "Policy",
      "skos:closeMatch": [
        {
          "@id": "sap:GovernancePrinciple"
        },
        {
          "@id": "sap:Policy"
        }
      ]
    },
    {
      "@id": "triodian:Organization",
      "rdfs:label": "Organization",
      "skos:closeMatch": [
        {
          "@id": "sap:OrgUnit"
        },
        {
          "@id": "sap:OrganizationalUnit"
        }
      ]
    },
    {
      "@id": "triodian:Initiative",
      "rdfs:label": "Initiative",
      "skos:closeMatch": [
        {
          "@id": "sap:ChangeInitiative"
        },
        {
          "@id": "sap:Initiative"
        }
      ]
    },
    {
      "@id": "triodian:Information",
      "rdfs:label": "Information",
      "skos:closeMatch": [
        {
          "@id": "sap:DataEntity"
        },
        {
          "@id": "sap:InformationObject"
        }
      ]
    },
    {
      "@id": "triodian:Product",
      "rdfs:label": "Product",
      "skos:closeMatch": [
        {
          "@id": "sap:Product"
        },
        {
          "@id": "sap:ServiceOrProduct"
        }
      ]
    },
    {
      "@id": "triodian:Service",
      "rdfs:label": "Service",
      "skos:closeMatch": [
        {
          "@id": "sap:BusinessService"
        },
        {
          "@id": "sap:Service"
        }
      ]
    },
    {
      "@id": "triodian:Stakeholder",
      "rdfs:label": "Stakeholder",
      "skos:closeMatch": [
        {
          "@id": "sap:BusinessRole"
        },
        {
          "@id": "sap:Stakeholder"
        }
      ]
    },
    {
      "@id": "triodian:Performance",
      "rdfs:label": "Performance",
      "skos:closeMatch": [
        {
          "@id": "sap:KPI"
        },
        {
          "@id": "sap:PerformanceIndicator"
        }
      ]
    }
  ]
}
