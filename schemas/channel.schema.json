          "entityID"
        ],
        "properties": {
          "dependencyType": {
            "description": "Type of dependency",
            "allOf": [
              {
                "$ref": "common.schema.json#/definitions/dependencyStrength"
              }
            ]
          },
          "domainType": {
            "description": "Type of domain this element depends on",
            "allOf": [
              {
                "$ref": "common.schema.json#/definitions/domainType"
              }
            ]
          },
          "entityID": {
            "type": "string",
            "description": "ID of the domain entity"
