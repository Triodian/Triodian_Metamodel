{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "External-Enterprise Composite Schema",
  "description": "Composite schema linking all external organization related schemas",
  "type": "object",
  "properties": {
    "externalOrganizations": {
      "type": "array",
      "items": {
        "$ref": "external-organization.schema.json"
      }
    },
    "interOrganizationalRelationships": {
      "type": "array",
      "items": {
        "$ref": "inter-organizational-relationship.schema.json"
      }
    },
    "sharedInitiatives": {
      "type": "array",
      "items": {
        "$ref": "shared-initiative.schema.json"
      }
    },
    "federatedGovernanceModels": {
      "type": "array",
      "items": {
        "$ref": "federated-governance-model.schema.json"
      }
    }
  }
}
